<resources xmlns:tools="http://schemas.android.com/tools">

        <!-- Base application theme for day mode -->
        <style name="Base.Theme.RETROWARE" parent="Theme.Material3.DayNight">
            <!-- Colores para el modo día -->
            <item name="colorPrimary">@color/miazul</item>
            <item name="colorPrimaryVariant">@color/miazulClaro</item>
            <item name="colorOnPrimary">@color/white</item>
            <item name="colorSecondary">@color/celeste</item>
            <item name="colorSecondaryVariant">@color/purple</item>
            <item name="colorOnSecondary">@color/black</item>
            <item name="colorSurface">@color/white</item>
            <item name="colorOnSurface">@color/black</item>
            <item name="backgroundColor">@color/white</item>
            <item name="colorOnBackground">@color/black</item>
            <item name="colorError">@color/red</item>
            <item name="colorOnError">@color/white</item>
        </style>

        <!-- Tema principal para la aplicación -->
        <style name="Theme.RETROWARE" parent="Base.Theme.RETROWARE" />

        <!-- Tema para la pantalla de splash -->
        <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
            <item name="android:windowBackground">@drawable/splash_background</item>
        </style>

        <!-- Estilo para botones en modo día -->
        <style name="Button.White" parent="Theme.AppCompat.Light.NoActionBar">
            <item name="colorAccent">@color/purple</item>
            <item name="colorControlActivated">@color/miazulClaro</item>
        </style>

        <!-- Base application theme for night mode -->
        <style name="Base.Theme.RETROWARE.Night" parent="Theme.Material3.DayNight">
            <!-- Colores para el modo noche -->
            <item name="colorPrimary">@color/night_primary</item>
            <item name="colorPrimaryVariant">@color/night_primary_variant</item>
            <item name="colorOnPrimary">@color/night_on_primary</item>
            <item name="colorSecondary">@color/night_secondary</item>
            <item name="colorSecondaryVariant">@color/night_secondary_variant</item>
            <item name="colorOnSecondary">@color/night_on_secondary</item>
            <item name="colorSurface">@color/night_surface</item>
            <item name="colorOnSurface">@color/night_on_surface</item>
            <item name="backgroundColor">@color/night_background</item>
            <item name="colorOnBackground">@color/night_on_background</item>
            <item name="colorError">@color/night_error</item>
            <item name="colorOnError">@color/night_on_error</item>
        </style>

        <!-- Tema para la pantalla de splash en modo noche -->
        <style name="SplashTheme.Night" parent="Theme.AppCompat.NoActionBar">
            <item name="android:windowBackground">@drawable/splash_background_night</item>
        </style>

        <!-- Estilo para botones en modo noche -->
        <style name="Button.White.Night" parent="Theme.AppCompat.NoActionBar">
            <item name="colorAccent">@color/night_purple</item>
            <item name="colorControlActivated">@color/night_miazulClaro</item>
        </style>
    </resources>
