<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/menu_navigation"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.marisma.retroware.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home2">
        <action
            android:id="@+id/action_homeFragment_to_detailItemFragment"
            app:destination="@id/detailItemFragment" />
    </fragment>

    <fragment
        android:id="@+id/favItemListFragment"
        android:name="com.marisma.retroware.FavItemListFragment"
        android:label="Favoritos"
        tools:layout="@layout/fragment_fav_item_list">
        <action
            android:id="@+id/action_favItemListFragment_to_detailFavItemFragment"
            app:destination="@id/detailFavItemFragment" />
    </fragment>

    <fragment
        android:id="@+id/userInfoFragment"
        android:name="com.marisma.retroware.UserInfoFragment"
        android:label="Usuario"
        tools:layout="@layout/fragment_user_info">
        <argument
            android:name="USERNAME"
            app:argType="string"
            android:defaultValue="Invitado"/>
    </fragment>

    <fragment
        android:id="@+id/detailItemFragment"
        android:name="com.marisma.retroware.DetailItemFragment"
        android:label="fragment_detail_item"
        tools:layout="@layout/fragment_detail_item">
        <argument
            android:name="videojuego"
            app:argType="com.marisma.retroware.Videojuego" />
    </fragment>

    <!-- Añade una acción para navegar desde MenuFragment a UserInfoFragment -->
    <action
        android:id="@+id/action_menuFragment_to_userInfoFragment"
        app:destination="@id/userInfoFragment">
        <argument
            android:name="user"
            app:argType="string"
            />
    </action>


    <fragment
        android:id="@+id/detailFavItemFragment"
        android:name="com.marisma.retroware.DetailFavItemFragment"
        android:label="Detalle de Favorito"
        tools:layout="@layout/fragment_detail_fav_item">
        <argument
            android:name="videojuego"
            app:argType="com.marisma.retroware.Videojuego" />
    </fragment>



</navigation>
